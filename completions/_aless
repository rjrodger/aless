#compdef aless
# zsh completion for aless, written by `aless --generate complete-zsh`.
# Install it as _aless in a directory on $fpath, or load it from
# ~/.zshrc after compinit: eval "$(aless --generate complete-zsh)"

_aless() {
  _arguments -S \
    '(--kind --format -k)--kind=[parse every input as FORMAT]:FORMAT:(json jsonl jsonic jsonc json5 yaml toml ini csv tsv xml zon markdown feed css proto pgn c abnf ebnf gbnf expr semver text)' \
    '(--kind --format -k)--format=[parse every input as FORMAT]:FORMAT:(json jsonl jsonic jsonc json5 yaml toml ini csv tsv xml zon markdown feed css proto pgn c abnf ebnf gbnf expr semver text)' \
    '(--kind --format -k)-k[parse every input as FORMAT]:FORMAT:(json jsonl jsonic jsonc json5 yaml toml ini csv tsv xml zon markdown feed css proto pgn c abnf ebnf gbnf expr semver text)' \
    '*--grammar=[a format of your own, from an ABNF grammar]:NAME=FILE:_files' \
    '*--grammar-expr=[the same, the grammar on the command line]:NAME=ABNF: ' \
    '--max-size=[refuse an input over SIZE (default 64M)]:SIZE: ' \
    '--timeout=[stop a parse past SECONDS (default none)]:SECONDS: ' \
    '--no-watch[do not reload files when they change]' \
    '--watch[reload files when they change (the default)]' \
    '(--mode -m)--mode=[start in data (default) or line mode]:MODE:(data line)' \
    '(--mode -m)-m[start in data (default) or line mode]:MODE:(data line)' \
    '--depth=[open only the first N levels]:N: ' \
    '--indent=[indentation per level (default 2)]:N: ' \
    '(--line-numbers -n)--line-numbers[number the rows]' \
    '(--line-numbers -n)-n[number the rows]' \
    '(--no-line-numbers -N)--no-line-numbers[do not number the rows]' \
    '(--no-line-numbers -N)-N[do not number the rows]' \
    '(--relative-line-numbers -r)--relative-line-numbers[number rows by distance from the focus]' \
    '(--relative-line-numbers -r)-r[number rows by distance from the focus]' \
    '(--no-relative-line-numbers -R)--no-relative-line-numbers[do not number rows by distance]' \
    '(--no-relative-line-numbers -R)-R[do not number rows by distance]' \
    '--scrolloff=[rows kept around the focus (default 3)]:N: ' \
    '--ascii[draw fold markers in ASCII]' \
    '(--no-color --no-colour)--no-color[no colours (as NO_COLOR does)]' \
    '(--no-color --no-colour)--no-colour[no colours (as NO_COLOR does)]' \
    '--no-mouse[do not capture the mouse]' \
    '(--help -h)--help[the options (-h), or the whole reference]' \
    '(--help -h)-h[the options (-h), or the whole reference]' \
    '(--version -V)--version[the version]' \
    '(--version -V)-V[the version]' \
    '--generate=[a man page or a shell'\''s completions]:WHAT:(man complete-bash complete-zsh complete-fish complete-powershell)' \
    '*:file:_files'
}

if [ "$funcstack[1]" = "_aless" ]; then
  _aless "$@"
else
  compdef _aless aless
fi
