# fish completion for aless, written by `aless --generate complete-fish`.
# Install it as aless.fish in a directory on $fish_complete_path.
complete -c aless -s k -l kind -l format -x -a 'json jsonl jsonic jsonc json5 yaml toml ini csv tsv xml zon markdown feed css proto pgn c abnf ebnf gbnf expr semver text' -d 'read every input as FORMAT'
complete -c aless -l grammar -r -F -d 'read your own format, from an ABNF grammar'
complete -c aless -l grammar-expr -x -d 'read your own format, from command-line ABNF'
complete -c aless -l max-size -x -d 'refuse an input over SIZE (default 64M)'
complete -c aless -l timeout -x -d 'stop a parse past SECONDS (default none)'
complete -c aless -l no-watch -d 'do not reload a file when it changes'
complete -c aless -l watch -d 'reload a file when it changes (the default)'
complete -c aless -l no-changes -d 'do not mark what a reload changed'
complete -c aless -s m -l mode -x -a 'data line' -d 'start in data (default) or line mode'
complete -c aless -l depth -x -d 'open only the first N levels'
complete -c aless -l indent -x -d 'indent N spaces a level (default 2)'
complete -c aless -s n -l line-numbers -d 'number the rows'
complete -c aless -s N -l no-line-numbers -d 'do not number the rows'
complete -c aless -s r -l relative-line-numbers -d 'number rows by distance from the focus'
complete -c aless -s R -l no-relative-line-numbers -d 'do not number rows by distance'
complete -c aless -l scrolloff -x -d 'keep N rows around the focus (default 3)'
complete -c aless -l ascii -d 'draw fold markers in ASCII'
complete -c aless -l no-color -l no-colour -d 'draw without colour, as NO_COLOR does'
complete -c aless -l no-mouse -d 'leave the mouse to the terminal'
complete -c aless -s h -l help -d 'print the options (-h) or the reference'
complete -c aless -s V -l version -d 'print the version'
complete -c aless -l generate -x -a 'man complete-bash complete-zsh complete-fish complete-powershell' -d 'print the man page or a shell\'s completions'
