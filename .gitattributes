* text=auto
tests/fixtures/** -text
# Byte for byte, whitespace-only lines included: the tests read them so.
examples/*.yaml -text -whitespace
# Written by `aless --generate` (admin/scripts/generate.sh) and installed as
# they are, so LF on every checkout, as the binary writes them.
man/** text eol=lf
completions/** text eol=lf
# The site's self-hosted fonts.
docs/fonts/** binary
# The prompt log only grows: two branches that each appended an entry
# keep both (DEV-PROCESS.md, "The prompt log").
sketch/PROMPT-LOG.md merge=union
