# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device.
#
# <file system>                           <mount point>   <type>  <options>       <dump>  <pass>
UUID=3f2b1c9e-8a4d-4e5f-9b6a-1c2d3e4f5a6b /               ext4    errors=remount-ro 0       1
UUID=A1B2-C3D4                            /boot/efi       vfat    umask=0077      0       1
LABEL=home                                /home           ext4    defaults,noatime 0       2
/dev/sdb1                                 /data           xfs     defaults,nofail 0       2
/dev/mapper/cryptswap                     none            swap    sw              0       0
tmpfs                                     /tmp            tmpfs   defaults,size=2G,mode=1777 0 0
proc                                      /proc           proc    defaults        0       0

# network shares
nas.example.com:/export/media             /mnt/media      nfs     ro,soft,intr    0       0
//fileserver/share                        /mnt/share      cifs    credentials=/etc/smbcred,uid=1000 0 0
/dev/sr0                                  /media/cdrom0   udf,iso9660 user,noauto
