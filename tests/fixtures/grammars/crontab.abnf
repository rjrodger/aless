; /etc/crontab: the system crontab, whose entries name the user to run as.
; A timed entry has the five schedule fields; a special entry starts with
; @reboot, @daily, ...; a one-word line is an environment setting.
crontab = *( timed %x0A / special %x0A / setting %x0A / %x0A ) [ timed / special / setting ]   ; @array
timed   = minute hour dom month dow user command      ; @object minute hour dom month dow user command
special = ( "@reboot" / "@yearly" / "@annually" / "@monthly" / "@weekly" / "@daily" / "@midnight" / "@hourly" ) user command   ; @object when user command
setting = word                                        ; @object env
minute  = word
hour    = word
dom     = word
month   = word
dow     = word
user    = word
command = 1*word                                      ; @array
word    = ( TX )
