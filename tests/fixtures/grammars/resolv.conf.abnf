; /etc/resolv.conf: one keyword per line; each keyword is its own record shape.
; A `;` comment line (resolv.conf(5) allows them beside `#`, and dhclient
; writes one) is kept as a record of its words: the lexer drops `#` comments,
; and a grammar cannot match a line and build nothing.
resolv     = *( nameserver %x0A / search %x0A / domain %x0A / options %x0A / sortlist %x0A / comment %x0A / %x0A ) [ nameserver / search / domain / options / sortlist / comment ]   ; @array
nameserver = "nameserver" address    ; @object nameserver
domain     = "domain" name           ; @object domain
search     = "search" words          ; @object search
options    = "options" words         ; @object options
sortlist   = "sortlist" words        ; @object sortlist
comment    = ";" text                ; @object comment
address    = word
name       = word
words      = 1*word                  ; @array
text       = *word                   ; @array
word       = ( TX )
