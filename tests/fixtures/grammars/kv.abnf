; Shell-style settings (os-release, .env, /etc/default/*): KEY=value per line,
; no spaces around the =; a value is bare words or a quoted string.
kv    = *( entry %x0A / %x0A ) [ entry ]   ; @array
entry = key "=" value                     ; @object key value
key   = word
value = *( word / ST / "=" )
word  = ( TX )
